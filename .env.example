# ---------------------------------------------------------------------------
#  Copy this file to `.env` and adjust the values:
#      cp .env.example .env
#  docker compose reads `.env` automatically.
# ---------------------------------------------------------------------------

# Port on your machine that will serve the web interface
APP_PORT=8080

# Application database name and credentials
DB_NAME=belta_trains
DB_USER=belta
DB_PASSWORD=belta

# MySQL root password (used by the db container only)
MYSQL_ROOT_PASSWORD=rootpass

# Set to 1 to re-import db/schema.sql + db/seed.sql on the next start
FORCE_DB_INIT=0
# TLS mode for the app -> MySQL connection:
#   disabled            - no TLS (default; safe inside the compose network)
#   required-no-verify  - encrypt, skip certificate verification
DB_SSL_MODE=disabled
